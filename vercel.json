{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "23plusone-happiness-scan-iota.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://23plusone-happiness-scan.br-ndpeople.com/" }
    },
    {
      "src": "/scan",
      "has": [{ "type": "host", "value": "23plusone-happiness-scan-iota.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://23plusone-happiness-scan.br-ndpeople.com/scan" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "/report/preview",
      "dest": "/public/report.html"
    },
    {
      "src": "/cards.json",
      "dest": "/public/cards.json"
    },
    {
      "src": "/23plusoneCards/(.*)",
      "dest": "/public/23plusoneCards/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|json|jpg|jpeg|png|gif|svg|webp|txt|xml|ico))",
      "dest": "/public/$1"
    },
    {
      "src": "/scan",
      "dest": "/public/scan.html"
    },
    {
      "src": "/research",
      "dest": "/public/research.html"
    },
    {
      "src": "/",
      "dest": "/public/scan.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
